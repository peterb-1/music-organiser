@page "/math"
@using Client.Services
@using Shared.DTOs
@inject MathService MathService

<h3>Math</h3>
<p>Result: @Result</p>
<button @onclick="CallApi">Add</button>

@code {
    private int Result { get; set; }

    private async Task CallApi()
    {
        var request = new MathRequest { A = 3, B = 5 };
        var result = await MathService.AddAsync(request);
        if (result != null)
        {
            Result = result.Result;
        }
    }
}
