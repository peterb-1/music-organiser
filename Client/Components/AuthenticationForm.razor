@using Client.Services
@using Client.Utils
@using Shared.DTOs

@inject AuthenticationService AuthenticationService

<p>Email</p>
<input @bind="Email" type="email" />
<p>Password</p>
<input @bind="Password" type="password" />
<button @onclick="Login">Login</button>
<button @onclick="Register">Register</button>
<p>@Error</p>

@code {
    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
    private string Error { get; set; } = string.Empty;

    [Parameter]
    public EventCallback OnSuccess { get; set; }

    private async Task Login()
    {
        var request = new LoginRequest { Email = Email, Password = Password };
        await PerformAuthenticationRequest(AuthenticationService.LoginAsync, request);
    }

    private async Task Register()
    {
        var request = new RegisterRequest { Email = Email, Password = Password };
        await PerformAuthenticationRequest(AuthenticationService.RegisterAsync, request);
    }

    private async Task PerformAuthenticationRequest<TRequest>(Func<TRequest, Task<Maybe<TokenResponse>>> authenticationAction, TRequest request)
    {
        await authenticationAction(request)
            .Then(async _ =>
            {
                Error = string.Empty;
                await OnSuccess.InvokeAsync();
            })
            .Catch(error =>
            {
                Error = error;
            });
    }
}
